  },
  "devDependencies": {
    "@midika/config-eslint": "workspace:*",
    "@midika/config-typescript": "workspace:*",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
